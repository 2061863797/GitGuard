{
  "name": "gitguard-verify",
  "version": "0.3.0",
  "private": true,
  "description": "GitGuard MCP server and agent plugin: deterministic checks plus agent- and user-written yes/no questions before commit",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc",
    "bundle": "node scripts/bundle.mjs",
    "clean": "rimraf dist",
    "lint": "oxlint --deny-warnings src tests scripts",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "test:bundle": "node scripts/test-bundle.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "0.28.2",
    "oxlint": "1.85.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0"
}
